          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choise random rate" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.util.Random

def response = prev.getResponseDataAsString()

def json = new JsonSlurper().parseText(response)
//log.info(&quot;Genres = &quot; + json.genres.toString())

boolean hasAdventure = json.genres.any { it.name == &apos;Adventure&apos; }
vars.put(&quot;HAS_ADVENTURE&quot;, hasAdventure.toString().trim())
//log.info(&quot;HAS_ADVENTURE = &quot; + vars.get(&quot;HAS_ADVENTURE&quot;))

Random rand = new Random()

int randomValue
if (hasAdventure) {
    randomValue = rand.nextInt(5) + 6
} else {
    randomValue = rand.nextInt(5) + 1
}

vars.put(&apos;range&apos;, randomValue.toString())

log.info(&quot;Выбранное случайное число range = &quot; + randomValue)
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
