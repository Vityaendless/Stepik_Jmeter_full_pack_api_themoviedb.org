        <BeanShellListener guiclass="TestBeanGUI" testclass="BeanShellListener" testname="Logs writer" enabled="true">
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="script">import java.io.*;
import java.nio.charset.StandardCharsets;
import java.text.SimpleDateFormat;
import java.util.Date;


String path = vars.get(&quot;PATH_TO_CSV&quot;);

if (props.get(&quot;CSV_WRITER&quot;) == null) {

    log.info(&quot;WRITER_INIT: creating writer&quot;);

    File f = new File(path);

    if (f.getParentFile() != null &amp;&amp; !f.getParentFile().exists()) {
        f.getParentFile().mkdirs();
    }

    BufferedWriter bw = new BufferedWriter(
        new OutputStreamWriter(
            new FileOutputStream(f, true),
            StandardCharsets.UTF_8
        )
    );

    props.put(&quot;CSV_WRITER&quot;, bw);

    if (f.length() == 0) {
        bw.write(&quot;time;thread;label;success;code;latency;bytes;msg\n&quot;);
        bw.flush();
    }
}

BufferedWriter bw = (BufferedWriter) props.get(&quot;CSV_WRITER&quot;);

long ts = prev.getTimeStamp();
String time = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date(ts));
String thread = prev.getThreadName();
String label = prev.getSampleLabel();
String success = prev.isSuccessful() ? &quot;true&quot; : &quot;false&quot;;
String code = prev.getResponseCode();
String latency = String.valueOf(prev.getLatency());
String bytes = String.valueOf(prev.getBytes());
String msg = prev.getResponseMessage() != null ? prev.getResponseMessage().replaceAll(&quot;[\\r\\n;]&quot;, &quot; &quot;) : &quot;&quot;;

String line = time + &quot;;&quot; + thread + &quot;;&quot; + label + &quot;;&quot; + success + &quot;;&quot; + code + &quot;;&quot; + latency + &quot;;&quot; + bytes + &quot;;&quot; + msg;

bw.write(line + &quot;\n&quot;);
bw.flush();
</stringProp>
        </BeanShellListener>
